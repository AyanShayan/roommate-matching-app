
@startuml
title Component Diagram - Proposed System Architecture

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false

actor "University Student" as Student

package "Mobile Application" {
  component "React Native + Expo\nTypeScript" as Mobile
}

package "NestJS Backend" {
  component "REST API" as API
  component "Authentication Module" as Auth
  component "Profile Module" as Profile
  component "Questionnaire Module" as Questionnaire
  component "Recommendation Module" as Recommendation
  component "Privacy Module" as Privacy
}

database "PostgreSQL\nDatabase" as DB

package "Python Machine Learning Service" {
  component "FastAPI Prediction API" as MLAPI
  component "Pairwise Feature\nPreprocessing" as Features
  artifact "Trained scikit-learn\nModel" as Model
}

Student --> Mobile : Interact with app
Mobile --> API : HTTPS / JSON

API --> Auth
API --> Profile
API --> Questionnaire
API --> Recommendation
API --> Privacy

Auth --> DB : Accounts
Profile --> DB : Student profiles
Questionnaire --> DB : Lifestyle responses
Privacy --> DB : Privacy settings
Recommendation --> DB : Retrieve candidate data

Recommendation --> MLAPI : Internal HTTP request
MLAPI --> Features : Prepare input features
Features --> Model : Run prediction
MLAPI --> Recommendation : Compatibility output

note bottom of Model
  Planned ML component.
  Training data and validated
  model are not yet available.
end note

@enduml
